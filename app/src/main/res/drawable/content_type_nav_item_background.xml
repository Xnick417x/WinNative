<?xml version="1.0" encoding="utf-8"?>
<!-- Tab chip background for component type navigation on the Components screen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/customChipSelected" />
            <stroke
                android:width="1dp"
                android:color="?attr/customChipSelectedStroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/customChipSurface" />
            <stroke
                android:width="1dp"
                android:color="?attr/customOutline" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
