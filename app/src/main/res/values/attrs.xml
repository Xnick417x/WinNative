<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="NumberPicker">
        <attr name="value" format="integer" />
        <attr name="minValue" format="integer|float" />
        <attr name="maxValue" format="integer|float" />
        <attr name="step" format="integer|float" />
        <attr name="textSize" format="dimension" />
    </declare-styleable>
    <declare-styleable name="SeekBar">
        <attr name="sbMinValue" format="float" />
        <attr name="sbMaxValue" format="float" />
        <attr name="sbStep" format="float" />
        <attr name="sbValue" format="float" />
        <attr name="suffix" format="string" />
        <attr name="sbTextSize" format="dimension" />
        <attr name="colorSecondary" format="color" />
    </declare-styleable>

    <attr name="extraKeysButtonTextColor" format="reference" />
    <attr name="extraKeysButtonActiveTextColor" format="reference" />
    <attr name="extraKeysButtonBackgroundColor" format="reference" />
    <attr name="extraKeysButtonActiveBackgroundColor" format="reference" />

    <attr name="customWindowBackground" format="color" />
    <attr name="customCardSurface" format="color" />
    <attr name="customOutline" format="color" />
    <attr name="customAccent" format="color" />
    <attr name="customTextPrimary" format="color" />
    <attr name="customTextSecondary" format="color" />
    <attr name="customActionSurface" format="color" />
    <attr name="customActionSurfacePressed" format="color" />
    <attr name="customPopupSurface" format="color" />
    <attr name="customPopupSurfaceEdge" format="color" />
    <attr name="customInputOutlineSoft" format="color" />
    <attr name="customSurfaceVariant" format="color" />
    <attr name="customChipSelected" format="color" />
    <attr name="customChipSelectedStroke" format="color" />
    <attr name="customChipSurface" format="color" />
</resources>
